<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hitit.aviation.desktop.ui.TarifeView">

    <top>
        <HBox fx:id="toolbar" alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>

            <Label fx:id="titleLabel" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Tarife" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="countLabel" text="0 uçuş" />

            <Button fx:id="addBtn" onAction="#promptAdd" prefHeight="26.0" prefWidth="114.0" text="Ekle" />

            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="editBtn" onAction="#promptEdit" text="Düzenle" />
            <Button fx:id="deleteBtn" onAction="#deleteSelected" prefHeight="26.0" prefWidth="49.0" text="Sil" />
            <Separator orientation="VERTICAL" />
            <Button fx:id="saveBtn" defaultButton="true" onAction="#save" text="Kaydet" />
            <Button fx:id="undoBtn" onAction="#undo" text="Geri Al" />
            <Label fx:id="dirtyLabel" style="-fx-text-fill:#b71c1c; -fx-font-weight:bold;" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="tableHolder">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="0.0" />
            </padding>
        </StackPane>
    </center>

</BorderPane>
